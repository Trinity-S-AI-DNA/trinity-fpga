# Synthesis scratch: netlists and logs are regenerable, and large.
# The generated WRAPPERS are not scratch -- they are the evidence of how a
# number was observed, and the harness gate reads them. Ignoring them once cost
# the provenance of several published figures, so only the netlists go.
fpga/phiscale/c_*.json
fpga/phiscale/c[sy]_*.log

# yosys netlist dumps: regenerable, tens of MB each
fpga/codebook/*.json
fpga/codebook/__pycache__/

# Phase-distribution dumps: regenerable from the checkpoints, tens of MB
research/block/loguniform_x_*.npy

# Local credentials - never commit (2026-10-05 leak cleanup)
secrets.h
.creds
**/.creds
